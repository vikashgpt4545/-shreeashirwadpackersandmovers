<IfModule mod_rewrite.c>
    RewriteEngine On

    # Dynamically serve master sitemap containing all 3,950+ pages
    RewriteRule ^sitemap\.xml$ generate_sitemap.php [L]

    # 301 Redirect Typo Slug Fixes (urls.txt reconciliation)
    RewriteRule ^packers-and-movers-nirrsa-dhanbad/?$ /packers-and-movers-nirsa-dhanbad [R=301,L]
    RewriteRule ^packers-and-movers-rohani-deoghar/?$ /packers-and-movers-rohini-deoghar [R=301,L]
    RewriteRule ^packers-and-movers-jarmundi-border-deoghar/?$ /packers-and-movers-jarmundi-deoghar [R=301,L]
    RewriteRule ^packers-and-movers-mahadeodekh-deoghar/?$ /packers-and-movers-mahadeopur-deoghar [R=301,L]
    RewriteRule ^packers-and-movers-shankari-deoghar/?$ /packers-and-movers-shankarpur-deoghar [R=301,L]
    RewriteRule ^packers-and-movers-tapasvan-deoghar/?$ /packers-and-movers-tapas-tapovan-deoghar [R=301,L]
    RewriteRule ^packers-and-movers-devipur-deoghar/?$ /packers-and-movers-devi-pur-deoghar [R=301,L]

    # 301 Redirect Patna Keyword-Variant Cannibalized Stubs
    RewriteRule ^(pages/)?affordable-packers-and-movers-in-patna(\.php)?$ /pages/packers-and-movers-in-patna.php [R=301,L]
    RewriteRule ^(pages/)?best-company-for-packers-and-movers-in-patna(\.php)?$ /pages/packers-and-movers-in-patna.php [R=301,L]
    RewriteRule ^(pages/)?best-movers-and-packers-in-patna(\.php)?$ /pages/packers-and-movers-in-patna.php [R=301,L]
    RewriteRule ^(pages/)?best-packer-and-mover-in-patna(\.php)?$ /pages/packers-and-movers-in-patna.php [R=301,L]
    RewriteRule ^(pages/)?best-packers-and-movers-in-patna(\.php)?$ /pages/packers-and-movers-in-patna.php [R=301,L]
    RewriteRule ^(pages/)?best-packers-and-movers-service-in-patna(\.php)?$ /pages/packers-and-movers-in-patna.php [R=301,L]
    RewriteRule ^(pages/)?cheap-packers-and-movers-in-patna(\.php)?$ /pages/packers-and-movers-in-patna.php [R=301,L]
    RewriteRule ^(pages/)?home-packers-and-movers-in-patna(\.php)?$ /pages/packers-and-movers-in-patna.php [R=301,L]
    RewriteRule ^(pages/)?list-of-packers-and-movers-in-patna(\.php)?$ /pages/packers-and-movers-in-patna.php [R=301,L]
    RewriteRule ^(pages/)?local-packers-and-movers-in-patna(\.php)?$ /pages/packers-and-movers-in-patna.php [R=301,L]
    RewriteRule ^(pages/)?movers-and-packers-in-patna-boring-road(\.php)?$ /pages/packers-and-movers-in-patna.php [R=301,L]
    RewriteRule ^(pages/)?movers-and-packers-in-patna-kankarbagh(\.php)?$ /pages/packers-and-movers-in-patna.php [R=301,L]
    RewriteRule ^(pages/)?movers-and-packers-in-patna-near-khajpura(\.php)?$ /pages/packers-and-movers-in-patna.php [R=301,L]
    RewriteRule ^(pages/)?movers-and-packers-in-patna-near-me(\.php)?$ /pages/packers-and-movers-in-patna.php [R=301,L]
    RewriteRule ^(pages/)?no-1-packers-and-movers-in-patna(\.php)?$ /pages/packers-and-movers-in-patna.php [R=301,L]
    RewriteRule ^(pages/)?packers-and-mover-in-patna(\.php)?$ /pages/packers-and-movers-in-patna.php [R=301,L]
    RewriteRule ^(pages/)?packers-movers-in-patna(\.php)?$ /pages/packers-and-movers-in-patna.php [R=301,L]
    RewriteRule ^(pages/)?professional-packers-and-movers-in-patna(\.php)?$ /pages/packers-and-movers-in-patna.php [R=301,L]
    RewriteRule ^(pages/)?reliable-packers-and-movers-in-patna(\.php)?$ /pages/packers-and-movers-in-patna.php [R=301,L]
    RewriteRule ^(pages/)?top-packers-and-movers-in-patna(\.php)?$ /pages/packers-and-movers-in-patna.php [R=301,L]
    RewriteRule ^(pages/)?verified-packers-and-movers-in-patna(\.php)?$ /pages/packers-and-movers-in-patna.php [R=301,L]
    RewriteRule ^(pages/)?bike-movers-and-packers-in-patna(\.php)?$ /pages/bike-transportation-in-patna.php [R=301,L]
    RewriteRule ^(pages/)?bike-packers-and-movers-in-patna(\.php)?$ /pages/bike-transportation-in-patna.php [R=301,L]
    RewriteRule ^(pages/)?car-movers-and-packers-in-patna(\.php)?$ /pages/car-transportation-in-patna.php [R=301,L]
    RewriteRule ^(pages/)?car-packers-and-movers-in-patna(\.php)?$ /pages/car-transportation-in-patna.php [R=301,L]
    RewriteRule ^(pages/)?iba-approved-movers-and-packers-in-patna(\.php)?$ /pages/iba-approved-packers-and-movers-in-patna.php [R=301,L]

    # Prevent Directory Browsing
    Options -Indexes

    # Force HTTPS for production domain (Skip on localhost/127.0.0.1)
    RewriteCond %{HTTP_HOST} !^localhost [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

    # 301 Redirect direct /pages/xyz.php requests to clean /xyz URL (handles multi-level subdirectories)
    RewriteCond %{THE_REQUEST} \s/+pages/(.+?)\.php[\s\?] [NC]
    RewriteRule ^pages/(.+)\.php$ /%1 [R=301,L]

    # Allow existing files and directories to pass through
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route clean URLs (single-level and nested subdirectories) to pages/ directory if target .php file exists
    # e.g., /packers-and-movers-in-ranchi -> pages/packers-and-movers-in-ranchi.php
    # e.g., /services/car-transportation -> pages/services/car-transportation.php
    # e.g., /packers-movers-india/madhya-pradesh/dewas -> pages/packers-movers-india/madhya-pradesh/dewas.php
    RewriteCond %{DOCUMENT_ROOT}/pages/$1.php -f [OR]
    RewriteCond pages/$1.php -f
    RewriteRule ^(.+?)/?$ pages/$1.php [L,QSA]

    # Custom 404 Error Page
    ErrorDocument 404 /pages/404.php
</IfModule>

# Prevent caching of sitemap XML files so changes update immediately
<IfModule mod_headers.c>
    <FilesMatch "(sitemap\.xml|sitemap.*\.xml)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </FilesMatch>
</IfModule>

# Enable Browser Caching (Expires Headers & Cache-Control for 1 year / 365 days)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(ico|jpe?g|png|gif|webp|svg|css|js|woff2)$">
        Header set Cache-Control "max-age=31536000, public"
    </FilesMatch>
</IfModule>

